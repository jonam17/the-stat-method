---
import { publishedArticles } from '../data/articles.js';
import { AUTHOR, supportUrl } from '../site.config.js';
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { TOOLS, findTool } from '../data/tools.js';
import { guideFor } from '../data/tool-guides.js';
import { ogPath } from '../og/pages.js';
import { embedFor, snippet } from '../data/embeds.js';
import { SITE } from '../site.config.js';

const { slug, title, intro } = Astro.props;
const tool = findTool(slug);
const related = (tool?.related || []).map(findTool).filter(Boolean);
const guide = guideFor(slug);
const articles = (await publishedArticles(d => d.relatedTool === slug)).slice(0, 3);
const category = tool?.category || 'Tool';
// Several tool titles already end in "calculator"; appending it unconditionally
// made screen readers announce "…calculator calculator".
const instrumentLabel = /calculator$/i.test(title) ? title : `${title} calculator`;
const seoTitles = {
  'macro-calculator': 'Macro Calculator — Calories, Protein, Carbs & Fat',
  'tdee-calculator': 'TDEE Calculator — Total Daily Energy Expenditure',
  'body-fat': 'Body Fat Calculator — Navy, BMI & Skinfold Methods',
  'ffmi': 'FFMI Calculator — Fat-Free Mass Index',
  'deficit-planner': 'Calorie Deficit Calculator — Goal Weight & Timeline',
  'one-rep-max': 'One Rep Max Calculator — 1RM & Training Loads',
  'heart-rate-zones': 'Heart Rate Zone Calculator — Karvonen & HRR',
  'calories-burned': 'Calories Burned Calculator — METs Activity Estimates',
  'powerlifting-score': 'DOTS Calculator — IPF GL Points & Wilks Score',
  'strength-standards': 'Strength Standards Calculator — Relative Strength',
  'rpe-converter': 'RPE Calculator — RIR & %1RM Converter',
  'plate-loader': 'Plate Calculator — Load Plates & Warm-Up Sets',
  'hand-portions': 'Hand Portion Calculator — Protein, Carbs & Fat',
  'protein-target': 'Protein Calculator — Daily Protein Target',
  'healthy-weight': 'Healthy Weight Calculator — BMI & Waist-to-Height',
  'sleep-calculator': 'Sleep Calculator — Bedtimes & Wake Times',
  'running-pace': 'Running Pace Calculator — Splits & Race Predictor',
  'caffeine-half-life': 'Caffeine Half-Life Calculator — Sleep Timing',
  'baseline': 'Baseline Calculator — Calories, Body Fat & Daily Targets',
};
// Meta descriptions for tools whose on-page intro is too short for search results (SEO audit,
// v2.54.2). The intro on the page is unchanged; these fill the 120-160 characters a snippet shows.
const seoDescriptions = {
  'protein-target': 'Find your daily protein target in grams: a range from bodyweight, or from lean body mass when you are cutting, with guidance on where to sit in it.',
  'hand-portions': 'Turn calorie and macro targets into palms, cupped hands and thumbs per meal, so you can track protein, carbs and fat without weighing your food.',
  'calories-burned': 'Estimate calories burned for 28 activities, from walking to running, using MET values from the 2024 Adult Compendium of Physical Activities.',
  'one-rep-max': 'Estimate your one-rep max with five formulas, then get a full percentage table and an RPE converter for setting working weights. Free, no sign-up.',
  'caffeine-half-life': 'See how much caffeine from coffee, tea or energy drinks is left at bedtime, shown as a range because its half-life varies widely between people.',
  'deficit-planner': 'Plan a calorie deficit and a goal date with a model that accounts for metabolic slowing, so the projection flattens the way real weight loss does.',
};
const metaDescription = seoDescriptions[slug] || intro;
const seoTitle = seoTitles[slug] || title;
// Embeddable calculators (item 60): a copy-ready iframe snippet, for the tools that have an embed page.
const embed = embedFor(slug) && tool ? snippet(slug, tool.name, SITE.url) : null;
const liveIndex = TOOLS.filter(t => t.live && t.slug).findIndex(t => t.slug === slug) + 1;
const toolSchema = tool?.live ? {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  description: intro,
  url: Astro.url.href,
  provider: { '@type': 'Organization', name: 'The Stat Method', url: Astro.site?.href || undefined },
} : null;
---
<BaseLayout title={seoTitle} description={metaDescription} pageType="WebPage"
  ogImage={tool?.live ? ogPath.tool(slug) : undefined} ogImageAlt={tool ? `${tool.name} — The Stat Method` : undefined}
  breadcrumbItems={[{ name: 'Calculators', href: '/tools/' }, { name: category, href: `/tools/#${category.toLowerCase()}` }]}
  extraJsonLd={toolSchema ? [toolSchema] : []}>
  <div class="wrap tool-page">
    <header class="tool-header">
      <div class="tool-crumb"><a href="/tools/">Toolkit</a><span>/</span>{category}</div>
      <div class="tool-header-grid">
        <div>
          <div class="tool-index-label">
            {liveIndex > 0 ? String(liveIndex).padStart(2, '0') : '—'} / {category}
          </div>
          <h1>{title}</h1>
          <p>{intro}</p>
          <slot name="lead" />
        </div>
        <div class="tool-header-meta">
          <span>The Stat Method INSTRUMENT</span>
          <strong>{tool?.live ? 'LIVE IN BROWSER' : 'IN DEVELOPMENT'}</strong>
          <small>NO ACCOUNT · INPUTS STAY LOCAL</small>
        </div>
      </div>
    </header>

    {guide && (
      <div class="tool-prelude">
        <div class="prelude-label">Before you calculate</div>
        <div class="prelude-content">
          {guide.howTo?.length > 0 && (
            <ol class="tb-steps">
              {guide.howTo.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{step}</li>)}
            </ol>
          )}
          {guide.terms?.length > 0 && (
            <details class="tb-terms">
              <summary>What the terms mean</summary>
              <dl>{guide.terms.map(([term, def]) => (<><dt>{term}</dt><dd>{def}</dd></>))}</dl>
            </details>
          )}
        </div>
      </div>
    )}

    <section class="tool-instrument" aria-label={instrumentLabel}>
      <div class="instrument-label">
        <span>01 / RUN THE INSTRUMENT</span>
        <span>MEASURE · UNDERSTAND · IMPROVE</span>
      </div>
      <slot />
    </section>

    {guide?.interpreting?.length > 0 && (
      <section class="tool-interpret">
        <div class="ti-head">
          <span class="eyebrow">02 / READING THE RESULT</span>
          <h2>What these numbers<br />actually tell you.</h2>
        </div>
        <div class="ti-body">
          {guide.interpreting.map(([heading, body], i) => (
            <div class="ti-item"><span>{String(i + 1).padStart(2, '0')}</span><div><h3>{heading}</h3><p>{body}</p></div></div>
          ))}
        </div>
      </section>
    )}

    <slot name="after" />

    {related.length > 0 && (
      <section class="related-tools">
        <div class="section-head"><h2>Continue the calculation</h2><a href="/tools/">VIEW ALL ↗</a></div>
        <div class="related-grid">
          {related.map(t => (
            <a class="related-row" href={`/tools/${t.slug}/`}><span>{t.category}</span><strong>{t.name}</strong><em>↗</em><p>{t.desc}</p></a>
          ))}
        </div>
      </section>
    )}

    {articles.length > 0 && (
      <section class="related-tools">
        <div class="section-head"><h2>Read next</h2><a href="/articles/">ALL FIELD NOTES ↗</a></div>
        <div class="cards">
          {articles.map(a => (
            <a class="card" href={`/articles/${a.id}/`}>
              <span class="cat" data-cat={a.data.category}>{a.data.category}</span>
              <h3>{a.data.title}</h3><p>{a.data.dek}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <p class="tool-report">
      Result look wrong? <a href="/report/">Report it</a> — corrections are made publicly.
    </p>

    {embed && (
      <dialog id="embed-dialog" class="embed-dialog" aria-labelledby="embed-dialog-h" closedby="any">
        <div class="ed-head">
          <h2 id="embed-dialog-h">Put this calculator on your website</h2>
          <button type="button" class="ed-close" data-embed-close aria-label="Close">✕</button>
        </div>
        <ol class="ed-steps">
          <li>Copy the code below.</li>
          <li>Paste it into your page where the calculator should go. In most site builders that is a
            "Custom HTML" or "Embed code" block.</li>
          <li>Publish. The calculator runs in your visitors' browsers, stores nothing and links back here.</li>
        </ol>
        <label class="te-label" for="embed-code">Embed code</label>
        <textarea id="embed-code" class="te-code" readonly rows="5" spellcheck="false">{embed}</textarea>
        <div class="ed-actions">
          <button type="button" class="te-copy" data-embed-copy>Copy code</button>
          <span class="te-status" role="status" data-embed-status></span>
        </div>
        <p class="ed-note">Colours follow each visitor's light or dark setting. To fix them, add{' '}
          <code>?theme=light</code> or <code>?theme=dark</code> to the end of the address inside the code.</p>
        <p class="ed-note"><a href={`/embed/${slug}/`} target="_blank" rel="noopener">See how it looks on its own ↗</a></p>
      </dialog>
    )}

    <section class="tool-support">
      <div><span class="eyebrow">KEEP THE TOOLS OPEN</span><p><b>Free, no account, nothing stored.</b> A one-off tip helps cover hosting and keeps the site ad-light.</p></div>
      <a class="btn-donate" href={supportUrl()} rel="noopener">♦ Support The Stat Method</a>
    </section>

    <AdSlot size="leaderboard" note="below the tool, never beside results" />
  </div>
</BaseLayout>
<script>
  // Embed dialog: close on its button; Esc and a click outside are the browser's (closedby="any").
  // Safari has no closedby yet: there, a click counts as outside only if it lands beyond the dialog's box,
  // so clicks on the dialog's own padding no longer close it (v2.54.1).
  const dlg = document.querySelector<HTMLDialogElement>('#embed-dialog');
  dlg?.querySelector('[data-embed-close]')?.addEventListener('click', () => dlg.close());
  if (dlg && !('closedBy' in HTMLDialogElement.prototype)) {
    dlg.addEventListener('click', e => {
      if (e.target !== dlg) return;
      const r = dlg.getBoundingClientRect();
      const inside = r.top <= e.clientY && e.clientY <= r.bottom && r.left <= e.clientX && e.clientX <= r.right;
      if (!inside) dlg.close();
    });
  }
  // Embed snippet: copy to the clipboard, or select it where the clipboard is not available.
  const btn = document.querySelector<HTMLButtonElement>('[data-embed-copy]');
  const code = document.querySelector<HTMLTextAreaElement>('#embed-code');
  const status = document.querySelector('[data-embed-status]');
  btn?.addEventListener('click', async () => {
    if (!code || !status) return;
    try { await navigator.clipboard.writeText(code.value); status.textContent = 'Copied.'; }
    catch { code.focus(); code.select(); status.textContent = 'Selected: press Ctrl+C or ⌘C to copy.'; }
  });
</script>
