---
import { AUTHOR, supportUrl } from '../site.config.js';
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { TOOLS, findTool } from '../data/tools.js';
import { guideFor } from '../data/tool-guides.js';
import { getCollection } from 'astro:content';

const { slug, title, intro } = Astro.props;
const tool = findTool(slug);
const related = (tool?.related || []).map(findTool).filter(Boolean);
const guide = guideFor(slug);
const articles = (await getCollection('articles',
  ({ data }) => !data.draft && data.relatedTool === slug)).slice(0, 3);
const category = tool?.category || 'Tool';
// Several tool titles already end in "calculator"; appending it unconditionally
// made screen readers announce "…calculator calculator".
const instrumentLabel = /calculator$/i.test(title) ? title : `${title} calculator`;
const seoTitles = {
  'macro-calculator': 'Macro Calculator — Calories, Protein, Carbs & Fat',
  'tdee-calculator': 'TDEE Calculator — Total Daily Energy Expenditure',
  'body-fat': 'Body Fat Calculator — Navy, BMI & Skinfold Methods',
  'ffmi': 'FFMI Calculator — Fat-Free Mass Index',
  'deficit-planner': 'Calorie Deficit Calculator — Goal Weight & Timeline',
  'one-rep-max': 'One Rep Max Calculator — 1RM & Training Loads',
  'heart-rate-zones': 'Heart Rate Zone Calculator — Karvonen & HRR',
  'calories-burned': 'Calories Burned Calculator — METs Activity Estimates',
  'powerlifting-score': 'Powerlifting Score Calculator — DOTS, IPF GL & Wilks',
  'strength-standards': 'Strength Standards Calculator — Relative Strength',
  'rpe-converter': 'RPE Calculator — RIR & %1RM Converter',
  'plate-loader': 'Plate Calculator — Load Plates & Warm-Up Sets',
  'hand-portions': 'Hand Portion Calculator — Protein, Carbs & Fat',
  'protein-target': 'Protein Calculator — Daily Protein Target',
  'healthy-weight': 'Healthy Weight Calculator — BMI & Waist-to-Height',
  'sleep-calculator': 'Sleep Calculator — Bedtimes & Wake Times',
  'running-pace': 'Running Pace Calculator — Splits & Race Predictor',
  'caffeine-half-life': 'Caffeine Half-Life Calculator — Sleep Timing',
};
const seoTitle = seoTitles[slug] || title;
const liveIndex = TOOLS.filter(t => t.live && t.slug).findIndex(t => t.slug === slug) + 1;
const toolSchema = tool?.live ? {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  description: intro,
  url: Astro.url.href,
  provider: { '@type': 'Organization', name: 'The Stat Method', url: Astro.site?.href || undefined },
} : null;
---
<BaseLayout title={seoTitle} description={intro} pageType="WebPage"
  breadcrumbItems={[{ name: 'Calculators', href: '/tools/' }, { name: category, href: `/tools/#${category.toLowerCase()}` }]}
  extraJsonLd={toolSchema ? [toolSchema] : []}>
  <div class="wrap tool-page">
    <header class="tool-header">
      <div class="tool-crumb"><a href="/tools/">Toolkit</a><span>/</span>{category}</div>
      <div class="tool-header-grid">
        <div>
          <div class="tool-index-label">
            {liveIndex > 0 ? String(liveIndex).padStart(2, '0') : '—'} / {category}
          </div>
          <h1>{title}</h1>
          <p>{intro}</p>
        </div>
        <div class="tool-header-meta">
          <span>The Stat Method INSTRUMENT</span>
          <strong>{tool?.live ? 'LIVE IN BROWSER' : 'IN DEVELOPMENT'}</strong>
          <small>NO ACCOUNT · INPUTS STAY LOCAL</small>
        </div>
      </div>
    </header>

    {guide && (
      <div class="tool-prelude">
        <div class="prelude-label">Before you calculate</div>
        <div class="prelude-content">
          {guide.howTo?.length > 0 && (
            <ol class="tb-steps">
              {guide.howTo.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{step}</li>)}
            </ol>
          )}
          {guide.terms?.length > 0 && (
            <details class="tb-terms">
              <summary>What the terms mean</summary>
              <dl>{guide.terms.map(([term, def]) => (<><dt>{term}</dt><dd>{def}</dd></>))}</dl>
            </details>
          )}
        </div>
      </div>
    )}

    <section class="tool-instrument" aria-label={instrumentLabel}>
      <div class="instrument-label">
        <span>01 / RUN THE INSTRUMENT</span>
        <span>MEASURE · UNDERSTAND · IMPROVE</span>
      </div>
      <slot />
    </section>

    {guide?.interpreting?.length > 0 && (
      <section class="tool-interpret">
        <div class="ti-head">
          <span class="eyebrow">02 / READING THE RESULT</span>
          <h2>What these numbers<br />actually tell you.</h2>
        </div>
        <div class="ti-body">
          {guide.interpreting.map(([heading, body], i) => (
            <div class="ti-item"><span>{String(i + 1).padStart(2, '0')}</span><div><h3>{heading}</h3><p>{body}</p></div></div>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="related-tools">
        <div class="section-head"><h2>Continue the calculation</h2><a href="/tools/">VIEW ALL ↗</a></div>
        <div class="related-grid">
          {related.map(t => (
            <a class="related-row" href={`/tools/${t.slug}/`}><span>{t.category}</span><strong>{t.name}</strong><em>↗</em><p>{t.desc}</p></a>
          ))}
        </div>
      </section>
    )}

    {articles.length > 0 && (
      <section class="related-tools">
        <div class="section-head"><h2>Read next</h2><a href="/articles/">ALL FIELD NOTES ↗</a></div>
        <div class="cards">
          {articles.map(a => (
            <a class="card" href={`/articles/${a.id}/`}>
              <span class="cat" data-cat={a.data.category}>{a.data.category}</span>
              <h3>{a.data.title}</h3><p>{a.data.dek}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="tool-support">
      <div><span class="eyebrow">KEEP THE TOOLS OPEN</span><p><b>Free, no account, nothing stored.</b> A one-off tip helps cover hosting and keeps the site ad-light.</p></div>
      <a class="btn-donate" href={supportUrl()} rel="noopener">♦ Support The Stat Method</a>
    </section>

    <AdSlot size="leaderboard" note="below the tool, never beside results" />
  </div>
</BaseLayout>
