---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { publishedNutrients, kindsWithEntries } from '../../../data/nutrients.js';
export async function getStaticPaths() {
  // Only kinds that have entries get a page; an empty section is never built.
  return (await kindsWithEntries()).map(k => ({ params: { kind: k.slug }, props: { k } }));
}
const { k } = Astro.props;
const items = (await publishedNutrients()).filter(n => n.data.kind === k.key);
---
<BaseLayout title={`${k.label} — Library — The Stat Method`}
  description={`${k.label}: how much you need, the best food sources, and what the evidence supports.`}
  breadcrumbItems={[{ name: 'Library', href: '/library/' }]}>
  <div class="wrap section">
    <div class="crumb"><a href="/library/">Library</a> / {k.label}</div>
    <h1>{k.label}</h1>
    <ul class="lib-list">
      {items.map(n => (<li><a href={`/library/${k.slug}/${n.id}/`}>{n.data.name}</a><span>{n.data.dek}</span></li>))}
    </ul>
  </div>
</BaseLayout>
