---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedNutrients, kindsWithEntries } from '../../data/nutrients.js';
import { publishedExercises, GROUPS } from '../../data/exercises.js';
const all = await publishedNutrients();
const exercises = await publishedExercises();
const exGroups = GROUPS.filter(g => exercises.some(e => e.data.group === g.key));
const kinds = await kindsWithEntries();
// Name what is actually in the Library: choline is neither a vitamin nor a mineral.
const nutrientWords = kinds.some(k => k.key === 'other') ? 'vitamins, minerals and other essential nutrients' : 'vitamins and minerals';
const Cap = s => s[0].toUpperCase() + s.slice(1);
// Sodium and chloride have no NIH fact sheet; their values come from the National
// Academies reports that set them. Say so wherever the Library names its source.
const reports = all.filter(n => n.data.source.kind === 'report').map(n => n.data.name.toLowerCase());
const fromWhom = reports.length ? 'the NIH or, where it has no fact sheet, the National Academies' : 'the NIH';
---
<BaseLayout noindex={all.length === 0 && exercises.length === 0} title="Library — The Stat Method"
  description={exercises.length
    ? `${Cap(nutrientWords.replace('other essential', 'other'))}, every value from ${reports.length ? 'the NIH or the National Academies' : 'the NIH'}, and exercises for each muscle group with the research behind each.`
    : `${Cap(nutrientWords)}: how much you need, the best food sources, and what the evidence does and does not support — every value from ${fromWhom}.`}>
  <div class="wrap section">
    <p class="eyebrow">Reference</p>
    <h1>Library</h1>
    <p class="dek">How much of each of the {nutrientWords} you need, where to get it, and what the evidence
      really supports. Every value comes from the NIH Office of Dietary Supplements, which presents the
      official U.S. intake recommendations{reports.length > 0 && <> (or, for {reports.join(' and ')}, which have no
      NIH fact sheet, from the National Academies reports that set their values)</>}, and each page is checked
      against its source.</p>
    {exercises.length > 0 && <p class="dek">Exercises for each muscle group have no official source to
      copy, so every claim on those pages is cited to a study we read and labelled with the kind of
      evidence it is.</p>}
    {kinds.map(k => (
      <section class="lib-kind">
        <h2><a href={`/library/${k.slug}/`}>{k.label}</a></h2>
        <ul class="lib-list">
          {all.filter(n => n.data.kind === k.key).map(n => (
            <li><a href={`/library/${k.slug}/${n.id}/`}>{n.data.name}</a><span>{n.data.dek}</span></li>
          ))}
        </ul>
      </section>
    ))}
    {exercises.length > 0 && (
      <section class="lib-kind">
        <h2><a href="/library/exercises/">Exercises</a></h2>
        <ul class="lib-list">
          {exGroups.map(g => (
            <li><a href={`/library/exercises/#${g.key}`}>{g.label}</a><span>{exercises.filter(e => e.data.group === g.key).map(e => e.data.name).join(' · ')}</span></li>
          ))}
        </ul>
      </section>
    )}
    <p class="lib-note">More {exercises.length ? 'nutrients and muscle groups are' : 'nutrients are'} added as each is checked against its sources.</p>
  </div>
</BaseLayout>
