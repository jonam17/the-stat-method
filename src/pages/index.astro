---
import { publishedArticles } from '../data/articles.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { liveTools, TOOLS } from '../data/tools.js';
import { publishedNutrients, kindsWithEntries } from '../data/nutrients.js';
import { publishedExercises, GROUPS } from '../data/exercises.js';

const articles = await publishedArticles();
const latest = articles.slice(0, 3);
const nutrients = await publishedNutrients();
const exercises = await publishedExercises();
const kinds = await kindsWithEntries();
const exGroups = GROUPS.filter(g => exercises.some(e => e.data.group === g.key));
const fmt = d => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const toolName = slug => TOOLS.find(t => t.slug === slug)?.name;

// Counted from the articles themselves, so the sentence cannot go stale. It says
// "all" only while every reference in every published article is marked checked.
const refs = articles.flatMap(a => a.data.references);
const checked = refs.filter(r => r.verified).length;
const citationLine = checked === refs.length
  ? `All ${refs.length} citations in our articles were checked against the original — that the source exists, and that it supports the specific claim made.`
  : `${checked} of the ${refs.length} citations in our articles have been checked against the original so far; each reference is marked either way.`;

const pillars = [
  { t: 'Every equation named', d: 'Each calculator lists the formulas it uses and the papers they came from. No black boxes.' },
  { t: 'Open source, auditable', d: 'The math is on GitHub with unit tests. Read it before you trust it.' },
  { t: 'Every source checked', d: citationLine },
  { t: 'Nothing stored, no signup', d: 'Calculators run in your browser. Your numbers never leave your device.' },
];
---
<BaseLayout title="The Stat Method — Evidence-Based Fitness & Nutrition Tools" pageType="WebSite"
  description="Evidence-based health, fitness and nutrition tools with transparent methods, named equations, cited sources, and clearly labeled estimates.">

  <section class="wrap hero-modern hp-hero">
    <div class="hero-modern-grid">
      <div class="hero-copy">
        <div class="hero-kicker">
          <span>01 / THE STARTING POINT</span>
          <span>MEASURE · UNDERSTAND · IMPROVE</span>
        </div>
        <span class="eyebrow">Evidence-based health · fitness · nutrition</span>
        <h1>Stop guessing.<br />Start <em>measuring.</em></h1>
        <p class="lede">
          The Stat Method turns the messy parts of nutrition, training, body composition, and recovery into
          instruments you can inspect. Change an input, follow the model, and see exactly what moves.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary hero-btn" href="/tools/baseline/">Get your baseline <span aria-hidden="true">↗</span></a>
          <a class="btn btn-text" href="/methodology/">How we calculate <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <a class="hero-visual hp-visual" href="/tools/baseline/" aria-label="Open The Stat Method Baseline">
        <div class="preview-frame">
          {/* Two captures of the Baseline, one per theme, written by `npm run previews`.
              The swap is done in CSS on [data-theme] so it follows the manual toggle.
              The light image stays eager (it is the LCP); the dark one is lazy. */}
          <img class="preview-shot preview-shot--light" src="/statmethod-baseline-preview.webp"
            alt="Static preview of The Stat Method Baseline with sample inputs: a short form on the left, and energy and body results on the right"
            width="1200" height="910" loading="eager" decoding="async" />
          <img class="preview-shot preview-shot--dark" src="/statmethod-baseline-preview-dark.webp"
            alt="" aria-hidden="true" width="1200" height="910" loading="lazy" decoding="async" />
        </div>
        <div class="hp-caption">
          <span>The Stat Method Baseline · static preview, sample inputs</span>
          <span>Run it yourself ↗</span>
        </div>
      </a>
    </div>
  </section>

  <section class="wrap hp-trust" aria-labelledby="hp-trust-h">
    <div class="hp-trust-head">
      <div>
        <span class="eyebrow">Why you can trust these numbers</span>
        <h2 id="hp-trust-h">No upsell, no gatekeeping, no hand-waving.</h2>
      </div>
      <a href="/about/">Why The Stat Method <span aria-hidden="true">→</span></a>
    </div>
    <div class="hp-trust-grid">
      {pillars.map((p, i) => (
        <div>
          <span class="hp-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section instruments-section">
    <div class="section-head section-head-wide">
      <div>
        <span class="eyebrow">02 / THE INSTRUMENTS</span>
        <h2>Tools built like tools.</h2>
      </div>
      <p>Small, focused calculators. Each one exposes the model behind the result and links you to the source material.</p>
    </div>
    <div class="instrument-list">
      {/* liveTools(), not TOOLS: the raw list includes unreleased entries. */}
      {liveTools().slice(0, 10).map((t, i) => (
        <a class="instrument-row" href={`/tools/${t.slug}/`}>
          <span class="instrument-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="instrument-name">{t.name}</span>
          <span class="instrument-desc">{t.desc}</span>
          <span class="instrument-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <a class="section-more" href="/tools/">View all {liveTools().length} tools <span aria-hidden="true">→</span></a>
  </section>

  <section class="wrap section hp-sec">
    <div class="section-head section-head-wide">
      <div>
        <span class="eyebrow">03 / THE LIBRARY</span>
        <h2>Reference you can check.</h2>
      </div>
      <p>How much of each nutrient you need, and exercises for each muscle group. Every value names its source.</p>
    </div>
    <div class="hp-domains">
      <a class="hp-domain" href="/library/#nutrients">
        <span class="eyebrow">Nutrition reference</span>
        <h3>Nutrients</h3>
        <p>Vitamins, minerals and other nutrients: how much you need, upper limits, food sources and what the evidence supports.</p>
        <span class="hp-count">{nutrients.length} nutrients · {kinds.length} types</span>
        <span class="hp-go">Browse nutrients →</span>
      </a>
      <a class="hp-domain" href="/library/#exercises">
        <span class="eyebrow">Exercise science</span>
        <h3>Exercises</h3>
        <p>Exercises by muscle group: equipment, the joints that move, how to do each one, and the studies behind it.</p>
        <span class="hp-count">{exercises.length} exercises · {exGroups.length} muscle groups</span>
        <span class="hp-go">Browse exercises →</span>
      </a>
    </div>
  </section>

  <section class="wrap section hp-sec">
    <div class="section-head section-head-wide">
      <div>
        <span class="eyebrow">04 / FIELD NOTES</span>
        <h2>The research, explained.</h2>
      </div>
      <p>The latest of {articles.length} articles. Every claim is cited, and each one ends with the calculator that puts it to use.</p>
    </div>
    <ul class="hp-rows">
      {latest.map(a => (
        <li>
          <a href={`/articles/${a.id}/`}>
            <span class="hp-tag"><span class="hp-dot" data-c={a.data.category} aria-hidden="true"></span>{a.data.category}{toolName(a.data.relatedTool) && <> · {toolName(a.data.relatedTool)}</>}</span>
            <strong>{a.data.title}</strong>
            <span class="hp-dek">{a.data.dek}</span>
            <span class="hp-meta">{fmt(a.data.published)} · {a.data.readMinutes} min read · {a.data.references.length} references</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="section-more" href="/articles/">All {articles.length} articles <span aria-hidden="true">→</span></a>
  </section>

  <div class="wrap"><AdSlot size="leaderboard" note="below the fold" /></div>
</BaseLayout>

<style>
  /* Hero: tighter, no dead band; the accent word replaces the old underline. */
  .hp-hero{padding-bottom:clamp(36px,5vw,56px)}
  .hp-hero .hero-modern-grid{min-height:0;align-items:start}
  .hp-hero .hero-kicker{margin-bottom:clamp(26px,3.6vw,44px)}
  .hp-hero h1{max-width:none}
  .hp-hero h1 em{font-style:normal;color:var(--signal);white-space:nowrap}
  @media(min-width:981px){ .hp-hero h1{font-size:min(clamp(58px,7.9vw,98px),13.4cqi)} }
  .hp-visual{display:block;text-decoration:none;color:inherit;margin-top:clamp(0px,3.6vw,56px)}
  .hp-visual .preview-frame{border:1px solid var(--line-strong);overflow:hidden;
    -webkit-mask-image:linear-gradient(#000 72%,transparent);mask-image:linear-gradient(#000 72%,transparent)}
  .hp-visual:hover .preview-frame{border-color:var(--ink)}
  .hp-caption{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:10px;font-family:var(--mono);
    font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mute)}
  .hp-caption span:last-child{color:var(--signal)}

  /* Trust: compact, straight after the hero. */
  .hp-trust{padding-block:22px 8px;border-top:1.5px solid var(--rule)}
  .hp-trust-head{display:flex;align-items:end;justify-content:space-between;gap:16px 28px;flex-wrap:wrap;margin-bottom:18px}
  .hp-trust-head h2{font-family:var(--display);font-weight:600;font-size:clamp(20px,2.6vw,26px);letter-spacing:-.02em;margin:8px 0 0}
  .hp-trust-head a{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);
    text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:3px;white-space:nowrap}
  .hp-trust-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}
  .hp-trust-grid > div{border-top:2px solid var(--line-strong);padding-top:11px}
  .hp-num{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--signal)}
  .hp-trust-grid h3{font-family:var(--display);font-weight:600;font-size:15px;margin:6px 0 5px}
  .hp-trust-grid p{font-size:13px;line-height:1.5;color:var(--ink-soft);margin:0}

  .hp-sec{padding-top:clamp(20px,3vw,34px)}

  /* Library cards (same pattern as the Library page). */
  .hp-domains{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .hp-domain{display:grid;gap:10px;align-content:start;background:var(--card);border:1px solid var(--line);
    border-top:3px solid var(--ink);padding:22px;text-decoration:none;color:inherit;transition:border-color .15s}
  .hp-domain:hover{border-color:var(--line-strong);border-top-color:var(--signal)}
  .hp-domain h3{font-family:var(--display);font-size:clamp(26px,3.2vw,36px);letter-spacing:-.04em;line-height:1;margin:2px 0 0}
  .hp-domain p{margin:0;color:var(--ink-soft);font-size:14.5px;max-width:44ch}
  .hp-count{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mute)}
  .hp-go{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--signal);margin-top:6px}

  /* Article rows (same pattern as the Articles page). */
  .hp-rows{list-style:none;padding:0;margin:0;display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));column-gap:28px}
  .hp-rows li{border-bottom:1px solid var(--line)}
  .hp-rows a{display:grid;gap:4px;padding:14px 0;text-decoration:none;color:inherit;align-content:start}
  .hp-rows a:hover strong{text-decoration:underline;text-decoration-color:var(--signal);text-underline-offset:3px}
  .hp-rows strong{font-family:var(--display);font-size:17px;letter-spacing:-.01em;line-height:1.3}
  .hp-dek{font-size:13.5px;color:var(--ink-soft)}
  .hp-meta,.hp-tag{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute)}
  .hp-tag{display:flex;align-items:center;gap:7px;letter-spacing:.1em}
  .hp-dot{width:12px;height:2px;background:var(--ink-mute);flex:none}
  .hp-dot[data-c="Nutrition"]{background:var(--nutrition)}
  .hp-dot[data-c="Exercise"]{background:var(--exercise)}
  .hp-dot[data-c="Health"]{background:var(--health)}
  .hp-dot[data-c="Recovery"]{background:var(--recovery)}

  @media (max-width:980px){
    .hp-visual{margin-top:0}
    .hp-trust-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .hp-rows{grid-template-columns:1fr}
  }
  @media (max-width:640px){
    .hp-domains{grid-template-columns:1fr}
    .hp-trust-grid{gap:16px 14px}
    .hp-trust-grid p{font-size:12.5px}
  }
  @media (prefers-reduced-motion:reduce){.hp-domain{transition:none}}
</style>
