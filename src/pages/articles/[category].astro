---
import { publishedArticles } from '../../data/articles.js';
/**
 * One page per category, generated at build time.
 *
 * Deliberately not a JavaScript filter on the index. Content pages here ship
 * with no executable JavaScript beyond the theme toggle, a filter would be the
 * first, and it would leave the categories invisible to search engines. Four
 * static pages cost nothing, work without JavaScript, and are indexable.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOOLS } from '../../data/tools.js';
import { CATEGORIES } from '../../data/categories.js';

export async function getStaticPaths() {
  const all = await publishedArticles();
  return CATEGORIES.map(c => ({
    params: { category: c.slug },
    props: {
      category: c,
      articles: all
        .filter(a => a.data.category === c.name)
        .sort((a, b) => b.data.published - a.data.published),
    },
  }));
}

const { category, articles } = Astro.props;
const fmt = d => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const toolName = slug => TOOLS.find(t => t.slug === slug)?.name;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${category.name} articles — The Stat Method`,
  numberOfItems: articles.length,
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.data.title,
    url: new URL(`/articles/${a.id}/`, Astro.site || 'https://statmethod.invalid').href,
  })),
};
---
<BaseLayout
  title={`${category.name} Articles — The Stat Method`}
  description={category.meta}
  pageType="CollectionPage"
  extraJsonLd={[schema]}
  breadcrumbItems={[{ name: 'Articles', href: '/articles/' }, { name: category.name, href: `/articles/${category.slug}/` }]}>
  <div class="wrap ac">
    <div class="crumb"><a href="/articles/">Articles</a> / {category.name}</div>

    <header class="ac-hero">
      <div>
        <span class="eyebrow"><span class="ac-dot" data-c={category.name} aria-hidden="true"></span>{articles.length} {articles.length === 1 ? 'article' : 'articles'}</span>
        <h1>{category.name}</h1>
      </div>
      <p>{category.description}</p>
    </header>

    <nav class="cat-filter ac-filter" aria-label="Article categories">
      <a href="/articles/">All</a>
      {CATEGORIES.map(c => (
        <a href={`/articles/${c.slug}/`} data-cat={c.name}
           aria-current={c.slug === category.slug ? 'page' : undefined}>{c.name}</a>
      ))}
    </nav>

    <ul class="ac-rows">
      {articles.map(a => (
        <li>
          <a href={`/articles/${a.id}/`}>
            <span class="ac-tag"><span class="ac-dot" data-c={a.data.category} aria-hidden="true"></span>{a.data.category}{toolName(a.data.relatedTool) && <> · {toolName(a.data.relatedTool)}</>}</span>
            <strong>{a.data.title}</strong>
            <span class="ac-dek">{a.data.dek}</span>
            <span class="ac-meta">{fmt(a.data.published)} · {a.data.readMinutes} min read · {a.data.references.length} references</span>
          </a>
        </li>
      ))}
    </ul>
    {category.intro && (
      <section class="ac-intro" aria-labelledby="ac-intro-h">
        <h2 id="ac-intro-h">About this section</h2>
        {category.intro.map(p => <p>{p}</p>)}
        {category.tools && (
          <ul class="ac-tools">
            {category.tools.map(slug => <li><a href={`/tools/${slug}/`}>{toolName(slug)} <span aria-hidden="true">→</span></a></li>)}
          </ul>
        )}
      </section>
    )}
    <a class="section-more" href="/articles/">Search all articles <span aria-hidden="true">→</span></a>
  </div>
</BaseLayout>

<style>
  /* Same rows as the Articles page (v2.40.0); these pages stay static, with no script. */
  .ac{padding-top:clamp(20px,4vw,40px);padding-bottom:80px}
  .ac-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(20px,5vw,64px);align-items:end;
    padding:14px 0 26px;border-bottom:1.5px solid var(--rule);margin-bottom:22px}
  .ac-hero .eyebrow{display:flex;align-items:center;gap:8px}
  .ac-hero h1{font-family:var(--display);font-weight:600;font-size:clamp(40px,6.4vw,76px);line-height:.95;
    letter-spacing:-.05em;margin:12px 0 0}
  .ac-hero p{margin:0;color:var(--ink-soft);font-size:16px;max-width:46ch}
  .ac-filter{margin-bottom:18px}
  .ac-intro{margin:28px 0 8px;max-width:68ch}
  .ac-intro h2{font-size:18px;margin:0 0 8px}
  .ac-intro p{color:var(--ink-soft);font-size:15px;line-height:1.6;margin:0 0 10px}
  .ac-tools{list-style:none;padding:0;margin:6px 0 0;display:flex;flex-wrap:wrap;gap:0 20px}
  .ac-tools a{display:inline-flex;align-items:center;min-height:44px;color:var(--ink);font-weight:600}
  .ac-rows{list-style:none;padding:0;margin:0 0 6px;border-top:1.5px solid var(--rule);
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:28px}
  .ac-rows li{border-bottom:1px solid var(--line)}
  .ac-rows a{display:grid;gap:4px;padding:14px 0;text-decoration:none;color:inherit}
  .ac-rows a:hover strong{text-decoration:underline;text-decoration-color:var(--signal);text-underline-offset:3px}
  .ac-rows strong{font-family:var(--display);font-size:17px;letter-spacing:-.01em}
  .ac-dek{font-size:13.5px;color:var(--ink-soft)}
  .ac-meta,.ac-tag{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute)}
  .ac-tag{display:flex;align-items:center;gap:7px;letter-spacing:.1em}
  .ac-dot{width:12px;height:2px;background:var(--ink-mute);flex:none;display:inline-block}
  .ac-dot[data-c="Nutrition"]{background:var(--nutrition)}
  .ac-dot[data-c="Exercise"]{background:var(--exercise)}
  .ac-dot[data-c="Health"]{background:var(--health)}
  .ac-dot[data-c="Recovery"]{background:var(--recovery)}
  @media (max-width:860px){ .ac-hero{grid-template-columns:1fr} }
  @media (max-width:640px){ .ac-rows{grid-template-columns:1fr} }
</style>
