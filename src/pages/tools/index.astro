---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIndex from '../../components/PageIndex.astro';
import { TOOLS } from '../../data/tools.js';
import { SEO_PRIORITY_TOOLS } from '../../data/seo-priority.js';
import { toolExample } from '../../data/tool-examples.js';

const live = TOOLS.filter(t => t.live && t.slug);
const planned = TOOLS.filter(t => !t.live);
const groups = ['Energy', 'Nutrition', 'Body', 'Performance', 'Cardio', 'Recovery'];
const toolListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Stat Method calculators',
  numberOfItems: live.length,
  itemListElement: live.map((t, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: t.name,
    url: new URL(`/tools/${t.slug}/`, Astro.site || 'https://statmethod.invalid').href,
  })),
};
const categoryIntro = {
  Energy: 'BMR, expenditure and energy-balance estimates.',
  Nutrition: 'Calories, macros and practical protein targets.',
  Body: 'Body-composition and weight-range estimates.',
  Performance: 'Strength, loading and performance measures.',
  Cardio: 'Heart rate, running and activity-energy tools.',
  Recovery: 'Sleep and stimulant timing estimates.',
};
---
<BaseLayout title="Health, Fitness & Nutrition Calculators — The Stat Method" pageType="CollectionPage" extraJsonLd={[toolListSchema]}
  description="Free health, fitness and nutrition calculators that show their work: named equations, cited sources, honest ranges, and no account or sign-up required.">
  <div class="wrap tools-hub">
    <header class="tools-hero">
      <div>
        <div class="eyebrow">01 / THE TOOLKIT</div>
        <h1>Calculators built<br />to show their work.</h1>
      </div>
      <div class="tools-hero-copy">
        <p>Small, focused instruments for health, fitness, exercise and nutrition. Run a calculation, then inspect the method, assumptions and sources behind it.</p>
        <div class="tools-proof"><span>{live.length} LIVE TOOLS</span><span>NO SIGNUP</span><span>DATA LOCAL</span></div>
      </div>
    </header>

    <PageIndex heading="On this page" unit="tools"
      items={groups.filter(g => live.some(t => t.category === g)).map(g => ({ href: `#${g.toLowerCase()}`, name: g, count: live.filter(t => t.category === g).length }))} />

    <section class="tools-start" aria-labelledby="start-here">
      <div class="tools-start-head">
        <div>
          <span class="eyebrow">START HERE</span>
          <h2 id="start-here">The five tools we built to answer the common questions first.</h2>
        </div>
        <p>High-intent calculations with the deepest supporting methodology and guides.</p>
      </div>
      <div class="tools-start-grid">
        {SEO_PRIORITY_TOOLS.map((slug, i) => {
          const t = live.find(item => item.slug === slug);
          return t ? <a class="start-tool" href={`/tools/${t.slug}/`}>
            <span>{String(i + 1).padStart(2, '0')}</span>
            <strong>{t.name}</strong>
            <em>{t.category} ↗</em>
          </a> : null;
        })}
      </div>
    </section>


    <div class="tool-groups">
      {groups.map((group, i) => {
        const items = live.filter(t => t.category === group);
        if (!items.length) return null;
        return (
          <section class="tool-group" id={group.toLowerCase()}>
            <div class="tool-group-head">
              <div>
                <span class="eyebrow">{String(i + 1).padStart(2, '0')} / {group}</span>
                <h2>{group}</h2>
              </div>
              <p>{categoryIntro[group]}</p>
            </div>
            <div class="instrument-library">
              {items.map((t, index) => {
                const e = toolExample(t.slug);
                return (
                  <a class="tp-row" href={`/tools/${t.slug}/`}>
                    <span class="tp-num">{String(index + 1).padStart(2, '0')}</span>
                    <span class="tp-main">
                      <span class="tp-name"><strong>{t.name}</strong><span class="pill-live">LIVE</span></span>
                      <span class="tp-desc">{t.desc}</span>
                      <span class="tp-io"><b>You enter</b><span>{e.enter}</span><b>You get</b><span>{e.get}</span></span>
                    </span>
                    <span class="tp-ex">
                      <b>Example</b>
                      <span class="tp-in">{e.inputs}</span>
                      <span class="tp-out"><span aria-hidden="true">→ </span>{e.result}</span>
                    </span>
                  </a>
                );
              })}
            </div>
            <a class="to-index" href="#on-this-page">↑ On this page</a>
          </section>
        );
      })}
    </div>

    <section class="tools-development">
      <div>
        <span class="eyebrow">07 / IN DEVELOPMENT</span>
        <h2>What's next.</h2>
      </div>
      <div class="planned-list">
        {planned.map(t => (
          <div class="planned-row">
            <strong>{t.name}</strong><span>{t.desc}</span><em>Planned</em>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Calculator rows with "You enter / You get" and a worked example (roadmap item 11, v2.45.0).
     Examples come from src/data/tool-examples.js, computed at build time. */
  .tp-row{display:grid;grid-template-columns:54px minmax(0,1.35fr) minmax(220px,1fr);gap:22px;padding:18px 0;
    border-bottom:1px solid var(--line);text-decoration:none;color:inherit;align-items:start;transition:background .15s}
  .tp-row:hover{background:#EFEDE8}
  .tp-num{font-family:var(--mono);font-size:9px;letter-spacing:.1em;color:var(--ink-mute);padding-top:4px}
  .tp-main{display:grid;gap:5px;min-width:0}
  .tp-name{display:flex;align-items:center;flex-wrap:wrap;gap:6px 10px}
  .tp-main strong{font-family:var(--display);font-size:16px;letter-spacing:-.01em}
  .tp-row:hover .tp-main strong{text-decoration:underline;text-decoration-color:var(--signal);text-underline-offset:3px}
  .tp-desc{font-size:13px;color:var(--ink-soft);line-height:1.5}
  .tp-io{display:grid;grid-template-columns:auto minmax(0,1fr);gap:3px 10px;margin-top:4px;font-size:12px;line-height:1.45;color:var(--ink-soft)}
  .tp-io b,.tp-ex>b{font-family:var(--mono);font-size:9px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mute);padding-top:2px;white-space:nowrap}
  .tp-ex{display:grid;gap:4px;align-content:start;border-left:2px solid var(--line-strong);padding:2px 0 2px 14px;min-width:0}
  .tp-in{font-size:12px;color:var(--ink-soft);line-height:1.45}
  .tp-out{font-family:var(--display);font-size:14px;font-weight:600;line-height:1.35;color:var(--ink);font-variant-numeric:tabular-nums}
  @media (max-width:860px){
    .tp-row{grid-template-columns:32px minmax(0,1fr);gap:10px 12px}
    .tp-ex{grid-column:2}
  }
  :global(:root[data-theme="dark"]) .tp-row:hover{background:#171717}
</style>
