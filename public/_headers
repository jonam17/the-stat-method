# Cloudflare Pages security and privacy headers.
# Keep analytics/ad origins out of this policy until those services are actually enabled.
# If a third-party script is added later, update CSP deliberately rather than using *.
# The policy intentionally permits inline style/script because Astro/React emit small
# inline payloads for the static site and structured data.
#
# NOTE: HSTS should only be enabled once the production hostname is HTTPS-only.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'

# Enable after the custom domain is live on HTTPS and you are comfortable with
# browser-enforced HSTS for the site and subdomains.
# Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
# The site-search data file (built by src/pages/search-index.json.js) is not a page; keep it out of
# search results (Search Console listed it as "Crawled – currently not indexed", 2026-11).
/search-index.json
  X-Robots-Tag: noindex

# Embeddable calculators (item 60): the only pages other sites may frame. The site-wide policy above is
# detached here (rules apply in file order) and set again with frame-ancestors opened; every other
# directive is the same. Keep the two policies in step when either changes.
/embed/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors *; object-src 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'
  X-Robots-Tag: noindex
